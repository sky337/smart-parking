model Facility {
  id              String        @id @default(cuid())
  name            String
  type            String        // e.g., "CCTV", "Lighting", "Guard", "Restroom"
  description     String?
  parkingLotId    String
  parkingLot      ParkingLot    @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([parkingLotId])
  @@map("facilities")
}

// ===== Pricing & Rules =====
model PricingRule {
  id                String          @id @default(cuid())
  name              String
  slotType String @default("STANDARD")
  baseRate          Float           // Rate per hour
  maxDailyRate      Float?          // Optional cap per day
  minimumDuration   Int             @default(30) // Minutes
  overtimeRate      Float?          // Rate after base time
  weekendMultiplier Float           @default(1.0)
  holidayMultiplier Float           @default(1.0)
  description       String?
  parkingLotId      String
  parkingLot        ParkingLot      @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  status String @default("ACTIVE")
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([parkingLotId])
  @@index([status])
  @@map("pricing_rules")
}

