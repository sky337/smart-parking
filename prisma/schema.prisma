// ===== Tickets & Parking Sessions =====
model Ticket {
  id                  String        @id @default(cuid())
  ticketNumber        String        @unique
  vehicleNumber       String
  vehicleType         String        @default("CAR")
  vehicleColor        String?
  entryTime           DateTime
  exitTime            DateTime?
  duration            Int?           // Minutes
  parkingSlotId       String
  parkingSlot         ParkingSlot   @relation(fields: [parkingSlotId], references: [id])
  operatorId          String
  operator            User          @relation(fields: [operatorId], references: [id])
  status String @default("ACTIVE")
  charges             Charge?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([vehicleNumber])
  @@index([parkingSlotId])
  @@index([operatorId])
  @@index([status])
  @@index([entryTime])
  @@map("tickets")
}

// enum String {
//   ACTIVE
//   COMPLETED
//   CANCELLED
//   LOST_TICKET
// }

model Charge {
  id                String          @id @default(cuid())
  ticketId          String          @unique
  ticket            Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  baseCharge        Float
  overtimeCharge    Float           @default(0)
  miscellaneous     Float           @default(0)
  discount          Float           @default(0)
  taxPercentage     Float           @default(0)
  tax               Float           @default(0)
  totalAmount       Float
  paymentMethod String @default("CASH")
  paymentStatus String @default("PENDING")
  transactionId     String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([ticketId])
  @@index([paymentStatus])
  @@map("charges")
}

