// ===== Parking Configuration =====
model ParkingLot {
  id            String        @id @default(cuid())
  name          String        @unique
  totalSlots    Int
  description   String?
  address       String?
  phone         String?
  email         String?
  status String @default("ACTIVE")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  slots         ParkingSlot[]
  pricingRules  PricingRule[]
  facilities    Facility[]

  @@map("parking_lots")
}

// enum String {
//   ACTIVE
//   INACTIVE
//   MAINTENANCE
// }

model ParkingSlot {
  id              String        @id @default(cuid())
  slotNumber      String        @unique
  floor           Int           @default(1)
  zone            String        @default("A")
  slotType String @default("STANDARD")
  status String @default("AVAILABLE")
  coordinates     String?       // JSON: {x, y} for visualization
  parkingLotId    String
  parkingLot      ParkingLot    @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tickets Ticket[]

  @@index([parkingLotId])
  @@index([status])
  @@map("parking_slots")
}

// enum String {
//   STANDARD
//   COMPACT
//   HANDICAP
//   RESERVED
//   PREMIUM
// }

// enum String {
//   AVAILABLE
//   OCCUPIED
//   RESERVED
//   MAINTENANCE
//   BLOCKED
