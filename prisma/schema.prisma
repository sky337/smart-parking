// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Authentication & Users =====
model User {
  id        String     @id @default(cuid())
  username  String     @unique
  email     String     @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole   @default(OPERATOR)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isDeleted Boolean    @default(false)

  tickets Ticket[]
  auditLogs AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ===== Parking Configuration =====
model ParkingLot {
  id            String        @id @default(cuid())
  name          String        @unique
  totalSlots    Int
  description   String?
  address       String?
  phone         String?
  email         String?
  status        LotStatus     @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  slots         ParkingSlot[]
  pricingRules  PricingRule[]
  facilities    Facility[]

  @@map("parking_lots")
}

enum LotStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model ParkingSlot {
  id              String        @id @default(cuid())
  slotNumber      String        @unique
  floor           Int           @default(1)
  zone            String        @default("A")
  slotType        SlotType      @default(STANDARD)
  status          SlotStatus    @default(AVAILABLE)
  coordinates     String?       // JSON: {x, y} for visualization
  parkingLotId    String
  parkingLot      ParkingLot    @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tickets Ticket[]

  @@index([parkingLotId])
  @@index([status])
  @@map("parking_slots")
}

enum SlotType {
  STANDARD
  COMPACT
  HANDICAP
  RESERVED
  PREMIUM
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  BLOCKED
}

model Facility {
  id              String        @id @default(cuid())
  name            String
  type            String        // e.g., "CCTV", "Lighting", "Guard", "Restroom"
  description     String?
  parkingLotId    String
  parkingLot      ParkingLot    @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([parkingLotId])
  @@map("facilities")
}

// ===== Pricing & Rules =====
model PricingRule {
  id                String          @id @default(cuid())
  name              String
  slotType          SlotType        @default(STANDARD)
  baseRate          Float           // Rate per hour
  maxDailyRate      Float?          // Optional cap per day
  minimumDuration   Int             @default(30) // Minutes
  overtimeRate      Float?          // Rate after base time
  weekendMultiplier Float           @default(1.0)
  holidayMultiplier Float           @default(1.0)
  description       String?
  parkingLotId      String
  parkingLot        ParkingLot      @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  status            RuleStatus      @default(ACTIVE)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([parkingLotId])
  @@index([status])
  @@map("pricing_rules")
}

enum RuleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ===== Tickets & Parking Sessions =====
model Ticket {
  id                  String        @id @default(cuid())
  ticketNumber        String        @unique
  vehicleNumber       String
  vehicleType         String        @default("CAR")
  vehicleColor        String?
  entryTime           DateTime
  exitTime            DateTime?
  duration            Int?           // Minutes
  parkingSlotId       String
  parkingSlot         ParkingSlot   @relation(fields: [parkingSlotId], references: [id])
  operatorId          String
  operator            User          @relation(fields: [operatorId], references: [id])
  status              TicketStatus  @default(ACTIVE)
  charges             Charge?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([vehicleNumber])
  @@index([parkingSlotId])
  @@index([operatorId])
  @@index([status])
  @@index([entryTime])
  @@map("tickets")
}

enum TicketStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  LOST_TICKET
}

model Charge {
  id                String          @id @default(cuid())
  ticketId          String          @unique
  ticket            Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  baseCharge        Float
  overtimeCharge    Float           @default(0)
  miscellaneous     Float           @default(0)
  discount          Float           @default(0)
  taxPercentage     Float           @default(0)
  tax               Float           @default(0)
  totalAmount       Float
  paymentMethod     PaymentMethod   @default(CASH)
  paymentStatus     PaymentStatus   @default(PENDING)
  transactionId     String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([ticketId])
  @@index([paymentStatus])
  @@map("charges")
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  CHEQUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ===== Receipts & Printing =====
model Receipt {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  ticketId        String
  chargeId        String
  generatedAt     DateTime      @default(now())
  printedAt       DateTime?
  printedCount    Int           @default(0)
  format          ReceiptFormat @default(THERMAL)
  data            String        // JSON: receipt data
  status          ReceiptStatus @default(GENERATED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ticketId])
  @@map("receipts")
}

enum ReceiptFormat {
  THERMAL
  A4
  PDF
}

enum ReceiptStatus {
  GENERATED
  PRINTED
  ARCHIVED
  CANCELLED
}

// ===== Reports =====
model Report {
  id              String        @id @default(cuid())
  reportType      ReportType
  title           String
  description     String?
  generatedBy     String        // User ID
  fromDate        DateTime
  toDate          DateTime
  filters         String?       // JSON serialized filters
  fileUrl         String?
  format          ExportFormat  @default(PDF)
  status          ReportStatus  @default(GENERATED)
  totalRecords    Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([reportType])
  @@index([createdAt])
  @@map("reports")
}

enum ReportType {
  DAILY_SUMMARY
  REVENUE_REPORT
  OCCUPANCY_REPORT
  VEHICLE_HISTORY
  PAYMENT_REPORT
  OPERATOR_PERFORMANCE
  SLOT_UTILIZATION
}

enum ExportFormat {
  PDF
  EXCEL
  CSV
}

enum ReportStatus {
  GENERATED
  EXPORTED
  ARCHIVED
}

// ===== Backup & Restore =====
model DatabaseBackup {
  id              String        @id @default(cuid())
  backupName      String        @unique
  backupPath      String
  backupSize      Int           // Bytes
  createdBy       String        // User ID
  restoredAt      DateTime?
  status          BackupStatus  @default(COMPLETED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@map("database_backups")
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  VERIFIED
}

// ===== Audit & Logging =====
model AuditLog {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  action          String
  entityType      String
  entityId        String?
  changes         String?       // JSON diff
  ipAddress       String?
  userAgent       String?
  status          String        @default("success")
  errorMessage    String?
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemLog {
  id              String        @id @default(cuid())
  level           LogLevel
  service         String
  message         String
  metadata        String?       // JSON
  stackTrace      String?
  createdAt       DateTime      @default(now())

  @@index([level])
  @@index([service])
  @@index([createdAt])
  @@map("system_logs")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  CRITICAL
}

// ===== Dashboard Widgets =====
model DashboardWidget {
  id              String        @id @default(cuid())
  name            String
  type            String        // e.g., "occupancy", "revenue", "active_tickets"
  config          String?       // JSON configuration
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("dashboard_widgets")
}
